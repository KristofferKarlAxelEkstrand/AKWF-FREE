# EditorConfig — https://editorconfig.org
# Works across VS Code, Cursor, Vim, etc. Complements .gitattributes (Git) and
# Prettier (format-on-save). Install the EditorConfig extension if your editor
# does not bundle it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf

[*.{wav,WAV,png,zip,wt}]
insert_final_newline = false
trim_trailing_whitespace = false
