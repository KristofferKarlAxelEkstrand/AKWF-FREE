{
	"cSpell.words": ["Akai", "AKWF", "Elektron"],
	"editor.formatOnSave": true,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"[markdown]": {
		"files.trimTrailingWhitespace": false
	},
	"prettier.requireConfig": true,
	"prettier.plugins": ["prettier-plugin-md"],
	"workbench.colorTheme": "AK Waveforms",
	// Generated by "npm run themes" — accent fallback for machines without the AK theme pack
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#432f52",
		"titleBar.activeForeground": "#ffffff",
		"titleBar.inactiveBackground": "#2c2339",
		"titleBar.inactiveForeground": "#ffffff",
		"commandCenter.foreground": "#ffffff",
		"commandCenter.activeForeground": "#ffffff",
		"commandCenter.inactiveForeground": "#ffffff",
		"commandCenter.border": "#ffffff1f",
		"commandCenter.activeBorder": "#ffffff33",
		"commandCenter.inactiveBorder": "#ffffff14",
		"activityBar.background": "#262032",
		"activityBar.foreground": "#ffffff",
		"activityBar.inactiveForeground": "#ffffffd9",
		"activityBar.activeBackground": "#31263f",
		"activityBar.activeBorder": "#4c335c",
		"activityBar.activeFocusBorder": "#4c335c",
		"activityBarBadge.background": "#402d4f",
		"activityBarBadge.foreground": "#ffffff",
		"statusBar.background": "#372946",
		"statusBar.foreground": "#ffffffd9",
		"sideBar.foreground": "#ffffffd9",
		"sideBarTitle.foreground": "#ffffffd9",
		"sideBarSectionHeader.foreground": "#ffffffd9",
		"icon.foreground": "#ffffffd9",
		"focusBorder": "#4c335c"
	}
}
